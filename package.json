  "scripts": {
    "lint": "nx run-many -t lint",
    "lint:report": "nx run-many -t lint --skip-nx-cache --force --format json --output-file \"tmp/lint/{projectName}.json\"",
    "lint:baseline": "npm run lint:report && npm run lint:baseline:check",
    "lint:baseline:check": "node scripts/check-lint-baseline.mjs layouts tmp/lint/layouts.json && node scripts/check-lint-baseline.mjs sam-layouts tmp/lint/sam-layouts.json",
    "lint:baseline:bump": "npm run lint:report && node scripts/check-lint-baseline.mjs --bump layouts tmp/lint/layouts.json && node scripts/check-lint-baseline.mjs --bump sam-layouts tmp/lint/sam-layouts.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:storybook-render": "node scripts/storybook-render.mjs dist/storybook/sam-layouts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "package:contract": "node scripts/check-package-contract.mjs dist/sam-layouts",
    "package:consumer": "node scripts/verify-package-consumer.mjs 21.0.0",
    "test:coverage": "node scripts/run-coverage.mjs",
    "coverage:check": "node scripts/check-coverage.mjs",
    "coverage:bump": "node scripts/check-coverage.mjs bump"
  },
  "private": true,
