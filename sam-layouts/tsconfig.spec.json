{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc",
    "module": "preserve",
    "target": "es2016",
    "types": ["vitest/globals", "node"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "emitDecoratorMetadata": false
  },
  "include": ["test-setup.ts", "test-stubs/**/*.ts", "src/**/*.test.ts", "src/**/*.spec.ts", "src/**/*.d.ts"]
}
