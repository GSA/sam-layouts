{
  "name": "layouts",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "sam-layouts/src",
  "prefix": "sds",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["dist/{projectRoot}"]
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "sam-layouts/ng-package.json",
        "tsConfig": "sam-layouts/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "sam-layouts/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "tsConfig": "sam-layouts/tsconfig.spec.json",
        "runnerConfig": "vitest-base.config.ts",
        "setupFiles": ["sam-layouts/test-setup.ts"],
        "coverage": true,
        "coverageInclude": ["src/**/*.ts"],
        "coverageExclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/**/*.d.ts"],
        "coverageReporters": ["text-summary", "json-summary", "lcov"]
      }
    }
  }
}
